# ============================================================
# SIH 26145 — Passive Cyber Intelligence Prototype
# Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# MongoDB connection string.
# For local development: mongodb://localhost:27017
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# If left empty or unavailable, the system falls back to in-memory storage.
MONGO_URL=mongodb://localhost:27017

# Paths to trained model and scaler artifacts (relative to backend/)
MODEL_PATH=diode_threat_model.pth
SCALER_PATH=scaler.pkl

# Comma-separated list of allowed CORS origins for the dashboard
CORS_ORIGINS=http://localhost:3000

# Optional: API base URL used by simulator and PCAP analyzer
API_URL=http://127.0.0.1:8000
